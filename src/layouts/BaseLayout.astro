---
import BaseHead from "../components/BaseHead.astro";
export type { Props } from "../components/BaseHead.astro";
const { title, description, image } = Astro.props;
---

<html lang="en" class="overflow-x-clip">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="relative flex min-h-screen w-full flex-col items-center justify-center overflow-x-clip">
    <slot />
    <svg
      class="fixed inset-0 -z-10 size-full opacity-20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <filter id="noise">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.55"
          numOctaves="1"
        ></feTurbulence>
      </filter>
      <rect class="size-full" filter="url(#noise)"></rect>
    </svg>
  </body>
</html>
