---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import NavBar from "../components/NavBar.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<main>
		<NavBar />
		<article class="bg-white backdrop-blur-sm outline-1 outline-gray-900/5">
			<div
				class="prose max-w-[83ch] prose-h1:text-5xl prose-h1:text-gray-800 prose-h2:mt-10 prose-headings:font-sans prose-p:font-serif"
			>
				{
					heroImage && (
						<Image
							class="w-full aspect-3/1 object-cover mb-0"
							src={heroImage}
							alt=""
						/>
					)
				}
				<div class="p-8">
					<div class="*:my-3">
						<h1>{title}</h1>
						{description && <h5 class="lead">{description}</h5>}
						<h6>Published: <FormattedDate date={pubDate} /></h6>
						<hr />
					</div>
					<slot />
				</div>
			</div>
		</article>
	</main>
</BaseLayout>
