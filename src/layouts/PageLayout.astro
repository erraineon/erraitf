---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import NavBar from "../components/NavBar.astro";

import type { Props as BaseProps } from "../components/BaseHead.astro";

type LayoutSize = "standard" | "wide" | "full";

const sizeClasses: Record<LayoutSize, string> = {
  standard: "max-w-[83ch]",
  wide: "max-w-[90rem]",
  full: "max-w-screen",
};

interface Props extends BaseProps {
  pubDate?: Date;
  updatedDate?: Date;
  image?: ImageMetadata;
  showHero?: boolean;
  headerSeparator?: boolean;
  size?: LayoutSize;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  showHero = true,
  headerSeparator,
  size = "standard",
} = Astro.props;

const currentSizeClass = sizeClasses[size];
---

<BaseLayout title={title} description={description} image={image}>
  <NavBar />
  <main
    class=`w-full ${currentSizeClass} bg-white outline outline-black/5 print:outline-none`
  >
    <header>
      {showHero && image && (
        <Image
          class="w-full object-cover print:hidden"
          src={image}
          alt=""
          width="1440"
        />
      )}
      <div class="mx-8 mt-6">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
          <hgroup class="contents">
            <h1 class="col-start-1 row-start-1 text-6xl font-bold text-gray-800">
              {title}
            </h1>
            {description && (
              <p class="col-start-1 row-start-2 text-xl font-light text-gray-500">
                {description}
              </p>
            )}
          </hgroup>
          <div class="col-start-2 row-start-1">
            <slot name="header-actions" />
          </div>
        </div>
        {pubDate && (
          <p class="my-6 flex gap-2 text-sm text-gray-400 uppercase print:hidden">
            <span>
              Posted <FormattedDate date={pubDate} />
            </span>
            {updatedDate && "•"}
            {updatedDate && (
              <span>
                Updated <FormattedDate date={updatedDate} />
              </span>
            )}
          </p>
        )}
      </div>
    </header>
    {headerSeparator && (
      <hr class="border-px mx-8 border-black/10 print:hidden" />
    )}

    <!-- The prose-pre stuff is to let pre elements shrink  -->
    <article class="m-8 prose max-w-full font-serif prose-gray prose-headings:font-sans prose-h2:mt-10 prose-pre:w-0 prose-pre:min-w-full prose-table:font-sans prose-th:font-medium">
      <slot />
    </article>
  </main>
</BaseLayout>
