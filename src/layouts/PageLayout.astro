---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import NavBar from "../components/NavBar.astro";

import type { Props as BaseProps } from "../components/BaseHead.astro";

type LayoutSize = "standard" | "wide" | "full";

const sizeClasses: Record<LayoutSize, string> = {
  standard: "max-w-[83ch]",
  wide: "max-w-[90rem]",
  full: "max-w-screen",
};

interface Props extends BaseProps {
  pubDate?: Date;
  image?: ImageMetadata;
  headerSeparator?: boolean;
  size?: LayoutSize;
}

const {
  title,
  description,
  pubDate,
  image,
  headerSeparator,
  size = "standard",
} = Astro.props;

const currentSizeClass = sizeClasses[size];
---

<BaseLayout title={title} description={description} image={image}>
  <NavBar />
  <main class=`w-full ${currentSizeClass} bg-white outline outline-black/5`>
    <header>
      {image && <Image class="w-full object-cover" src={image} alt="" />}
      <div class="mx-8 mt-6">
        <hgroup>
          <h1 class="text-6xl font-bold text-gray-800">{title}</h1>
          <p class="mt-2 text-xl font-light text-gray-500">{description}</p>
        </hgroup>
        {pubDate && (
          <p class="my-6 text-sm text-gray-400 uppercase">
            Posted <FormattedDate date={pubDate} />
          </p>
        )}
      </div>
    </header>
    {headerSeparator && <hr class="border-px mx-8 my-8 border-black/10" />}

    <!-- The prose-pre stuff is to let pre elements shrink  -->
    <article class="m-8 prose max-w-full font-serif prose-gray prose-headings:font-sans prose-h2:mt-10 prose-pre:w-0 prose-pre:min-w-full">
      <slot />
    </article>
  </main>
</BaseLayout>
