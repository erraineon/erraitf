---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "../../components/FormattedDate.astro";
import PageLayout from "../../layouts/PageLayout.astro";

// Get all permutations of sections by category
export async function getStaticPaths() {
  const sections = await getCollection("sections");
  return sections.flatMap((section) => {
    const { categories = {}, mainCategory } = section.data;
    const baseSectionPath = {
      params: { section: section.id, path: undefined },
      props: { section },
    };
    const categoryPaths = Object.keys(categories)
      .filter((categoryKey) => categoryKey !== mainCategory)
      .map((categoryKey) => ({
        params: { section: section.id, path: `by/${categoryKey}` },
        props: { section, categoryKey },
      }));

    return [baseSectionPath, ...categoryPaths];
  });
}

const { section, categoryKey } = Astro.props;
const { Content } = await render(section);

const {
  title,
  description,
  sourceCollection,
  showPostDate,
  mainCategory: mainCategoryKey,
  categories = {},
} = section.data;

const posts = (await getCollection(sourceCollection))
  .filter((post) => !post.data.isDraft)
  .toSorted(
    (a, b) =>
      (b.data.updatedDate ?? b.data.pubDate).valueOf() -
      (a.data.updatedDate ?? a.data.pubDate).valueOf(),
  );

const sectionPath = `/${section.id}`;
const currentCategoryKey = categoryKey ?? mainCategoryKey;
const categoryLinks = Object.entries(categories).map(([key, category]) => ({
  key: key,
  label: category.label,
  href: key === mainCategoryKey ? sectionPath : `${sectionPath}/by/${key}`,
}));

let postGroups;
if (currentCategoryKey !== undefined) {
  // null here means that the posts are uncategorized, which get appended after all the other ones.
  const postsByOption = Map.groupBy(
    posts,
    (post) => post.data.categories?.[currentCategoryKey] ?? null,
  );

  postGroups = [...categories[currentCategoryKey].options, null]
    .map((option) => ({
      option: option ?? { label: "Uncategorized", description: null },
      posts: postsByOption.get(option?.key ?? null) ?? [],
    }))
    .filter((x) => x.posts.length > 0);
} else {
  postGroups = [{ option: null, posts }];
}
---

<PageLayout title={title} description={description}>
  <Content />
  <!-- Hide category links if there's none or only one -->
  {categoryLinks.length > 1 && (
    <nav
      slot="header-actions"
      class="prose prose-ul:list-none prose-ul:ps-0 prose-li:ps-0"
    >
      <ul class="flex flex-row-reverse justify-end gap-2">
        {categoryLinks.map(({ key: categoryKey, label, href }) => (
          <li>
            <a
              href={href}
              aria-current={
                currentCategoryKey === categoryKey ? "page" : undefined
              }
              class:list={[
                "px-3 py-2 font-sans no-underline",
                currentCategoryKey === categoryKey &&
                  "bg-gray-700 prose-invert",
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {postGroups.map((group) => (
    <section>
      {group.option && (
        <>
          <h2>{group.option.label}</h2>
          {group.option.description && <p>{group.option.description}</p>}
        </>
      )}
      <ul class="not-prose mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {group.posts.map((post) => (
          <li>
            <a
              class="grid aspect-video grid-rows-1 bg-gray-100"
              href={`/${
                sourceCollection === "blog"
                  ? post.id
                  : `${sourceCollection}/${post.id}`
              }`}
            >
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt={post.data.title}
                  class="col-start-1 row-start-1 size-full object-cover"
                />
              )}
              {/* min-w-0 is to let the h3 truncate as it shrinks. */}
              <div class="z-10 col-start-1 row-start-1 flex min-w-0 items-baseline justify-between gap-2 self-end bg-black/70 px-2 py-1 font-sans">
                <h3 class="truncate text-gray-100">{post.data.title}</h3>
                {showPostDate && (
                  <FormattedDate
                    class="text-sm text-nowrap text-gray-300"
                    date={post.data.updatedDate ?? post.data.pubDate}
                  />
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</PageLayout>
