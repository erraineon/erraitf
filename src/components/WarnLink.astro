---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  triggerEvent: string;
}

const {
  href,
  target,
  rel,
  title,
  triggerEvent,
  class: className,
  ...props
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel}
  title={title}
  class={className}
  data-warn-trigger={triggerEvent}
  {...props}
>
  <slot />
</a>

<script>
  const warnLinks = document.querySelectorAll<HTMLAnchorElement>(
    "a[data-warn-trigger]",
  );

  warnLinks.forEach((link) => {
    link.addEventListener("click", (e: MouseEvent) => {
      if (e.button === 0 && !e.ctrlKey && !e.metaKey) {
        const triggerEvent = link.dataset.warnTrigger;
        if (triggerEvent) {
          e.preventDefault();
          window.dispatchEvent(
            new CustomEvent(triggerEvent, {
              detail: {
                href: link.href,
                target: link.target,
                rel: link.rel,
              },
            }),
          );
        }
      }
    });
  });
</script>
