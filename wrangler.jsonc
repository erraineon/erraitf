{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "erraitf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "ERRAITF_BUCKET",
      "bucket_name": "erraitf-images",
      "remote": true,
    },
  ],
  "vars": {
    "IMAGES_CDN_URL": "https://images.errai.tf",
  },
}
